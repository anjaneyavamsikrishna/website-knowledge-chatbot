# Copy to .env and fill in. NEVER commit .env.

# ---- admin ---------------------------------------------------------------
# Long random string. Required for POST /api/ingest and GET /api/logs/*. Empty = admin endpoints disabled.
ADMIN_TOKEN=
# Where visitors are sent for quotes/bookings (set to the real PlacidWay contact/quote page).
CONTACT_URL=https://www.placidway.com/

# ---- LLM -----------------------------------------------------------------
LLM_PROVIDER=openai            # openai | anthropic
LLM_MODEL=gpt-4o-mini          # any chat model your provider offers
LLM_API_KEY=
# Optional OpenAI-compatible endpoint (Gemini, Groq, Ollama, Azure...). Leave empty for OpenAI.
LLM_BASE_URL=

# ---- Embeddings ----------------------------------------------------------
EMBEDDING_PROVIDER=openai      # openai | sentence-transformers
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_API_KEY=             # falls back to LLM_API_KEY
EMBEDDING_BASE_URL=
# Free-tier friendly pacing (raise the interval / lower the batch size if you still see 429s):
EMBEDDING_BATCH_SIZE=16
EMBEDDING_MIN_INTERVAL_S=2.0
CHUNK_MIN_CHARS=400            # tiny sections are merged into larger chunks (fewer vectors, fewer API calls)

# ---- ONE-KEY PRESETS (uncomment ONE block; leave EMBEDDING_API_KEY empty so the same key + endpoint is used) ----
# A) Gemini (free tier available; key from Google AI Studio). Verify model names with:
#    curl https://generativelanguage.googleapis.com/v1beta/openai/models -H "Authorization: Bearer YOUR_KEY"
# LLM_PROVIDER=openai
# LLM_API_KEY=YOUR_GEMINI_KEY
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# LLM_MODEL=<pick a name printed by: python scripts/check_providers.py>   (gemini-2.0-flash may be retired -> 404)
# EMBEDDING_PROVIDER=openai
# EMBEDDING_MODEL=gemini-embedding-001
# B) OpenAI (needs prepaid credit on the account, even for a brand-new key): defaults above.
# C) Free local embeddings (no API for embeddings; pip install -r requirements-local-embeddings.txt):
# EMBEDDING_PROVIDER=sentence-transformers
# EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# ---- Retrieval -----------------------------------------------------------
# Cosine-similarity gate. Calibrate with: python scripts/probe_retrieval.py "<queries>"
SIMILARITY_THRESHOLD=0.30      # MUST be calibrated: python scripts/probe_retrieval.py --calibrate  (Gemini embeddings need ~0.6+)
RETRIEVAL_TOP_K=5

# ---- Crawler (be polite and identifiable: put a real contact address!) ---
CRAWLER_USER_AGENT=PlacidWayAssessmentBot/1.0 (educational assessment; contact: your-email@example.com)
REQUEST_DELAY_S=1.0

# ---- Runtime -------------------------------------------------------------
DATA_DIR=./data
# Build the knowledge base automatically on boot if it is empty (useful when the host has no persistent disk).
AUTO_INGEST_ON_STARTUP=false
RATE_LIMIT_PER_MINUTE=20
LOG_LEVEL=INFO
