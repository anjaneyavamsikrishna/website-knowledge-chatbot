# Replace the host and issuer, then copy to k8s/ingress.yaml and add to kustomization.yaml.
apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  name: website-knowledge-chatbot
  annotations:
    cert-manager.io/cluster-issuer: letsencrypt-prod
spec:
  ingressClassName: traefik
  tls:
    - hosts: [chatbot.example.com]
      secretName: chatbot-tls
  rules:
    - host: chatbot.example.com
      http:
        paths:
          - path: /
            pathType: Prefix
            backend:
              service:
                name: website-knowledge-chatbot
                port:
                  name: http
